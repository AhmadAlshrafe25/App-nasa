{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && uv run --frozen python -m backend.main",
    "build": "cd ../.. && uv run --frozen python -m compileall -q backend ai companion",
    "start": "cd ../.. && uv run --frozen python -m backend.main",
    "family:dev": "tsx src/family-server.ts",
    "family:build": "esbuild src/family-server.ts --bundle --platform=node --format=esm --external:express --external:cors --external:pino-http --external:pino --external:pg --external:drizzle-orm --external:@clerk/express --external:@clerk/shared/keys --external:@google-cloud/storage --external:http-proxy-middleware --outfile=dist/family-server.mjs",
    "family:start": "node dist/family-server.mjs",
    "test:backend": "cd ../.. && uv run --frozen --extra ml pytest -q",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.89",
    "@clerk/shared": "^4.45.0",
    "@google-cloud/storage": "^9.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.1",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
